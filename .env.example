# Copy this file to .env and add your key locally.
# Never paste your Gemini key into chat or commit your real .env file.
GEMINI_API_KEY=

# Change this to a model available to your Gemini API key's free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8000
# Keep the SQLite database local to this Codespace; Git ignores this file.
TAXEZ_DATABASE_PATH=./data/taxez.sqlite
